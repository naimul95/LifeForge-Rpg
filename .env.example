# Neon PostgreSQL connection string. Copy from the Neon project dashboard.
DATABASE_URL=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate a long random value locally; never commit or share it.
JWT_SECRET=

# Cloudinary Console -> Product Environment -> API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public browser origin, for example http://localhost:3000 or https://app.example.com.
APP_URL=http://localhost:3000
